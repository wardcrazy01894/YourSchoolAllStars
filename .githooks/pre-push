#!/usr/bin/env bash
# Pre-push gate: run exactly what CI's required checks run, and refuse the push
# on the first failure. Judged by EXIT CODE (set -euo pipefail) — never by
# filtered/tailed output, which has hidden red gates before.
#
# Enable once per clone:   npm run hooks:install
# (sets core.hooksPath=.githooks in the shared .git/config, so it applies to
# every worktree — one checked out on a branch that predates this file simply
# runs no hook). Skip only for a genuine emergency with `git push --no-verify`.
#
# Note: it checks the WORKING TREE, not just the commits being pushed, so
# commit or stash unrelated edits first or they can sway the result.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: typecheck → lint → format:check → test → build"
npm run --silent typecheck
npm run --silent lint
npm run --silent format:check
npm test --silent
npm run --silent build
echo "pre-push: all gates green"
